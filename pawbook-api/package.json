{
  "name": "pawbook-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "contracts"
  ],
  "scripts": {
    "dev": "bun --watch src/main.api.ts",
    "start": "bun src/main.api.ts",
    "start:node": "node dist/main.api.js",
    "start:worker": "bun src/main.worker.ts",
    "start:worker:node": "node dist/main.worker.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:integration": "bun test ./test",
    "db:up": "docker compose -f docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "build": "bun build src/main.api.ts src/main.worker.ts src/main.migrate.ts --target=node --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/main.migrate.ts",
    "depcruise": "depcruise src contracts/src",
    "contracts:generate": "bun scripts/dump-openapi.ts && openapi-typescript contracts/openapi.json -o contracts/src/generated/openapi.ts && biome check --write contracts/openapi.json contracts/src/generated"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-openapi": "^1.6.3",
    "@pawbook/contracts": "workspace:*",
    "@stream-io/node-sdk": "0.8.15",
    "drizzle-orm": "^0.45.4",
    "hash-wasm": "^4.13.0",
    "hono": "^4.13.18",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bun": "^1.4.4",
    "@types/node": "22",
    "dependency-cruiser": "^18.7.2",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  }
}
