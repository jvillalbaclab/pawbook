{
  "openapi": "3.1.0",
  "info": {
    "title": "PawBook API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "headers": {
      "RateLimit-Limit": {
        "description": "Solicitudes permitidas en la ventana actual.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "RateLimit-Remaining": {
        "description": "Solicitudes que quedan en la ventana actual.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "RateLimit-Reset": {
        "description": "Segundos hasta que se reinicia la ventana.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "RateLimit-Policy": {
        "description": "Política aplicada: `límite;w=ventana en segundos` (p. ej. `120;w=60`).",
        "schema": {
          "type": "string",
          "example": "120;w=60"
        }
      },
      "Retry-After": {
        "description": "Segundos que hay que esperar antes de reintentar.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "Idempotent-Replayed": {
        "description": "`true` si la respuesta se reproduce de una solicitud anterior con la misma Idempotency-Key.",
        "schema": {
          "type": "string",
          "enum": ["true"]
        }
      }
    },
    "responses": {
      "TooManyRequests": {
        "description": "Límite de solicitudes superado (NFR-SEC-004).",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/Retry-After"
          },
          "RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimit-Limit"
          },
          "RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimit-Remaining"
          },
          "RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimit-Reset"
          },
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimit-Policy"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Falta el access token, no es válido o ha caducado.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string",
              "example": "Bearer realm=\"pawbook\""
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token de `POST /v1/auth/sign-in`, `/google` o `/refresh` (15 min)."
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "example": "https://pawbook.app/problems/not-found"
          },
          "title": {
            "type": "string",
            "example": "No encontramos lo que buscas"
          },
          "status": {
            "type": "integer",
            "example": 404
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "example": "/v1/pets/luna"
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["path", "message"]
            }
          }
        },
        "required": ["type", "title", "status"]
      },
      "IdempotencyKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": "^[\\x21-\\x7e]+$",
        "description": "Clave única por operación. Reintentar con la misma clave y el mismo cuerpo devuelve la respuesta original sin repetir la operación.",
        "example": "0192f5e4-7c1a-7b3e-9a40-5d1f0c2b8e61"
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        },
        "required": ["status", "version"]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "unavailable"]
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": ["ok", "fail"]
            },
            "example": {
              "postgres": "ok",
              "valkey": "ok"
            }
          }
        },
        "required": ["status", "checks"]
      },
      "SignUpResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["verification-pending"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["status", "message"]
      },
      "SignUpRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "description": "Correo electrónico.",
            "example": "ana@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "Entre 10 y 128 caracteres. Se rechaza si aparece en listas de contraseñas filtradas.",
            "example": "una frase larga y propia"
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "description": "Fecha de nacimiento (AAAA-MM-DD). Debe cumplir la edad mínima de registro.",
            "example": "1995-04-23"
          },
          "termsVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Versión de los términos y la política de privacidad que el usuario acepta (OR-LEG-001). Debe ser la vigente.",
            "example": "2026-11-17"
          }
        },
        "required": ["email", "password", "birthDate", "termsVersion"]
      },
      "AuthSession": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "enum": ["Bearer"]
          },
          "accessToken": {
            "type": "string",
            "description": "JWT para `Authorization: Bearer`."
          },
          "expiresIn": {
            "type": "integer",
            "description": "Segundos de vida del access token (15 min).",
            "example": 900
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": ["string", "null"],
            "description": "Refresh token rotatorio de un solo uso. `null` si se entregó en cookie. Reutilizar uno ya usado revoca toda la sesión (FR-AUTH-004)."
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/Me"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "expiresIn",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt",
          "user"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "description": "Correo electrónico.",
            "example": "ana@example.com"
          },
          "status": {
            "type": "string",
            "enum": ["pending_verification", "active"],
            "description": "`pending_verification` hasta verificar el correo (FR-AUTH-001/002)."
          },
          "emailVerified": {
            "type": "boolean"
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "description": "Fecha de nacimiento (AAAA-MM-DD). Debe cumplir la edad mínima de registro.",
            "example": "1995-04-23"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "termsAcceptance": {
            "type": ["object", "null"],
            "properties": {
              "version": {
                "type": "string"
              },
              "acceptedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": ["version", "acceptedAt"],
            "description": "Última aceptación registrada de los términos (OR-LEG-001)."
          }
        },
        "required": [
          "id",
          "email",
          "status",
          "emailVerified",
          "birthDate",
          "createdAt",
          "termsAcceptance"
        ]
      },
      "SignInRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "description": "Correo electrónico.",
            "example": "ana@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "refreshTokenDelivery": {
            "type": "string",
            "enum": ["body", "cookie"],
            "default": "body",
            "description": "`body` (por defecto, móvil): el refresh token va en la respuesta. `cookie` (web): va en una cookie `HttpOnly; Secure; SameSite=Lax` y `refreshToken` es `null`."
          }
        },
        "required": ["email", "password"]
      },
      "GoogleSignInResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AuthSession"
          },
          {
            "type": "object",
            "properties": {
              "isNewUser": {
                "type": "boolean"
              }
            },
            "required": ["isNewUser"]
          }
        ]
      },
      "GoogleSignInRequest": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "ID token (JWT) obtenido de Google Identity Services."
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "description": "Obligatoria solo si la cuenta no existe todavía.",
            "example": "1995-04-23"
          },
          "termsVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Obligatoria solo si la cuenta no existe todavía.",
            "example": "2026-11-17"
          },
          "refreshTokenDelivery": {
            "type": "string",
            "enum": ["body", "cookie"],
            "default": "body",
            "description": "`body` (por defecto, móvil): el refresh token va en la respuesta. `cookie` (web): va en una cookie `HttpOnly; Secure; SameSite=Lax` y `refreshToken` es `null`."
          }
        },
        "required": ["idToken"]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Obligatorio si no se envía la cookie de refresh (clientes móviles)."
          }
        }
      },
      "SignOutRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Obligatorio si no se envía la cookie de refresh (clientes móviles)."
          }
        }
      },
      "VerifyEmailResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["verified"]
          }
        },
        "required": ["status"]
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": ["token"]
      },
      "ForgotPasswordResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["accepted"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["status", "message"]
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "description": "Correo electrónico.",
            "example": "ana@example.com"
          }
        },
        "required": ["email"]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "Entre 10 y 128 caracteres. Se rechaza si aparece en listas de contraseñas filtradas.",
            "example": "una frase larga y propia"
          }
        },
        "required": ["token", "newPassword"]
      },
      "SessionPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Session"
            }
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "Cursor de la página siguiente; `null` si no hay más."
          }
        },
        "required": ["items", "nextCursor"]
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "userAgent": {
            "type": ["string", "null"]
          },
          "current": {
            "type": "boolean",
            "description": "`true` si es la sesión de este access token."
          }
        },
        "required": ["id", "createdAt", "lastUsedAt", "expiresAt", "userAgent", "current"]
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "schema": {
          "$ref": "#/components/schemas/IdempotencyKey"
        },
        "required": false,
        "description": "Clave única por operación. Reintentar con la misma clave y el mismo cuerpo devuelve la respuesta original sin repetir la operación.",
        "name": "Idempotency-Key",
        "in": "header"
      }
    }
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": ["Sistema"],
        "summary": "Liveness: el proceso está vivo",
        "responses": {
          "200": {
            "description": "Proceso activo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ready": {
      "get": {
        "tags": ["Sistema"],
        "summary": "Readiness: las dependencias responden y la instancia puede recibir tráfico",
        "responses": {
          "200": {
            "description": "Lista",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Alguna dependencia no responde",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sign-up": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Registro con correo, contraseña y fecha de nacimiento",
        "description": "FR-AUTH-001 y OR-LEG-001. La respuesta es la misma exista o no el correo; si existe, se envía un aviso al buzón. La cuenta queda `pending_verification` hasta abrir el enlace del correo (24 h).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[\\x21-\\x7e]+$",
              "description": "Clave única por operación. Reintentar con la misma clave y el mismo cuerpo devuelve la respuesta original sin repetir la operación.",
              "example": "0192f5e4-7c1a-7b3e-9a40-5d1f0c2b8e61"
            },
            "required": false,
            "description": "Clave única por operación. Reintentar con la misma clave y el mismo cuerpo devuelve la respuesta original sin repetir la operación.",
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Solicitud aceptada; revisa tu correo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignUpResponse"
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos, edad mínima no alcanzada, contraseña filtrada o términos desactualizados",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v1/auth/sign-in": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Inicio de sesión con correo y contraseña",
        "description": "Devuelve un access token de 15 min y un refresh token rotatorio de 30 días (FR-AUTH-004). Con `refreshTokenDelivery: cookie` el refresh va en una cookie HttpOnly (web).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "401": {
            "description": "Correo o contraseña incorrectos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "description": "El límite de intentos no está disponible; reintenta más tarde",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/google": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Inicio de sesión o registro con Google (OIDC)",
        "description": "FR-AUTH-003. Verifica el ID token de Google. Si el correo ya tiene cuenta, la vincula. Si la cuenta es nueva, exige `birthDate` y `termsVersion` (422 si faltan: el cliente los pide y reintenta con el mismo ID token).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleSignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoogleSignInResponse"
                }
              }
            }
          },
          "401": {
            "description": "ID token no válido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Google no ha verificado el correo",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Alta simultánea con el mismo correo",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Faltan datos de registro o no son válidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "description": "Google no está configurado en este entorno",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Renueva el access token rotando el refresh token",
        "description": "FR-AUTH-004. El refresh token presentado (cuerpo o cookie) se consume y se emite otro. Reutilizar uno ya consumido revoca toda la sesión. La respuesta usa el mismo canal (cuerpo o cookie) por el que llegó el token.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens renovados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token ausente, desconocido, caducado, revocado o reutilizado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v1/auth/sign-out": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Cierra la sesión del refresh token",
        "description": "Revoca la sesión y borra la cookie de refresh. Es idempotente.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignOutRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sesión cerrada"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v1/auth/verify-email": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Verifica el correo con el token del enlace",
        "description": "FR-AUTH-002. El enlace vale 24 h. Caducado: 410 y se puede pedir otro.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          }
        },
        "responses": {
