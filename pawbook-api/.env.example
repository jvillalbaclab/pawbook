# Copiar a .env para desarrollo local. Valores alineados con docker/docker-compose.yml.
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
DATABASE_URL=postgres://pawbook:pawbook@localhost:5435/pawbook
VALKEY_URL=redis://localhost:6380
# Orígenes separados por comas que pueden llamar a la API desde el navegador.
CORS_ORIGINS=http://localhost:3000
S3_ENDPOINT=http://localhost:9010
