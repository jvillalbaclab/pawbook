# Copiar a .env para desarrollo local. Valores alineados con docker/docker-compose.yml.
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
DATABASE_URL=postgres://pawbook:pawbook@localhost:5435/pawbook
VALKEY_URL=redis://localhost:6380
# Orígenes separados por comas que pueden llamar a la API desde el navegador.
CORS_ORIGINS=http://localhost:3000
# Proxies de confianza delante de la API. 0 = ignorar X-Forwarded-For (nadie la puede falsificar).
TRUSTED_PROXY_HOPS=0
S3_ENDPOINT=http://localhost:9010
# --- identity
# Secreto HS256 de los access tokens (mínimo 32 caracteres). Genera uno: openssl rand -base64 48
AUTH_ACCESS_TOKEN_SECRET=cambia-esto-por-un-secreto-aleatorio-de-48-caracteres
# PROVISIONAL hasta la decisión T-F0.02 (PRD Q2: 14, 16 o 18).
MIN_SIGNUP_AGE=18
TERMS_VERSION=2026-11-17
WEB_APP_URL=http://localhost:3000
# file: los correos se escriben en EMAIL_OUTBOX_DIR (ignorado por git). memory: se descartan.
EMAIL_TRANSPORT=file
EMAIL_OUTBOX_DIR=.local/mail
# Client IDs de Google separados por comas; vacío = login con Google deshabilitado.
GOOGLE_CLIENT_IDS=
# hibp: comprueba contraseñas filtradas (necesita red). off: sin comprobación.
PASSWORD_BREACH_CHECK=hibp
# --- social / GetStream
# Credenciales de la app de Stream (van juntas). Vacías: tokens falsos en desarrollo y 503 en producción.
STREAM_API_KEY=
STREAM_API_SECRET=
